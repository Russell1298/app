# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# PostgreSQL
POSTGRES_USER=scanner
POSTGRES_PASSWORD=changeme
POSTGRES_DB=scanner

# Constructed automatically by docker-compose from the vars above.
# Set this manually when running the API outside Docker.
# DATABASE_URL=postgresql+asyncpg://scanner:changeme@localhost:5432/scanner

# CORS — comma-separated list of allowed frontend origins.
# Add your Lovable preview URL and production domain here.
ALLOWED_ORIGINS=http://localhost:3000,https://sekura.lovable.app,https://sekura.cloud,https://www.sekura.cloud

# Stripe (add when you integrate payments)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PDF_PRICE_ID=price_...

# Email delivery via Resend (add when you integrate email)
# RESEND_API_KEY=re_...
# FROM_EMAIL=reports@yourdomain.com
